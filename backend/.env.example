# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration (Hỗ trợ MongoDB Atlas hoặc Replica Set)
MONGODB_URI=mongodb://localhost:27017/sports_booking?replicaSet=rs0

# Redis Configuration (Dùng cho Mutex Lock & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret
JWT_SECRET=super_secret_jwt_sports_booking_key_2026
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (cho script Seed Data: npm run seed)
ADMIN_PHONE=0999999999
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin

# PayOS Payment Gateway
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here


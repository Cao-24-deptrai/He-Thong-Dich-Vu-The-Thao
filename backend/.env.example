# Server & Environment
PORT=3000
NODE_ENV=development

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/sports_booking?replicaSet=rs0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=change_this_to_a_strong_secret
JWT_EXPIRES_IN=7d

# Default System Accounts
ADMIN_PHONE=240106
ADMIN_PASSWORD=123456
ADMIN_NAME=Quản trị viên

# PayOS Payment Gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Firebase Admin SDK (Service Account)
# Lấy từ Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Lưu ý: giữ nguyên ký tự \n trong chuỗi private key khi đặt trong .env
FIREBASE_PRIVATE_KEY=
# Web API Key (dùng để đồng bộ xác thực mật khẩu Firebase -> MongoDB khi đăng nhập)
FIREBASE_WEB_API_KEY=
